<RCC>
    <qresource prefix="/icons">
        <file alias="qtet.png">favicon/qtet.png</file>
        <file alias="qtet-green.png">favicon/qtet-green.png</file>
        <file alias="qtet-red.png">favicon/qtet-red.png</file>
        <file alias="net-page.svg">icons/net-page.svg</file>
        <file alias="eye.svg">icons/eye.svg</file>
        <file alias="eye-slash.svg">icons/eye-slash.svg</file>
        <file alias="delete.svg">icons/delete.svg</file>
        <file alias="edit.svg">icons/edit.svg</file>
        <file alias="play.svg">icons/play.svg</file>
        <file alias="stop.svg">icons/stop.svg</file>
        <file alias="log.svg">icons/log.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="favorites.svg">icons/favorites.svg</file>
    </qresource>
    <qresource prefix="/">
        <file>publicservers.json</file>
        <file>field_mapping.json</file>
    </qresource>
</RCC>
